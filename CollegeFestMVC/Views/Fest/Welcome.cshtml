@{
    ViewData["Title"] = "Welcome";
}

<div class="container mt-5">

    <div class="card shadow text-center">

        <div class="card-body p-5">

            <h1 class="display-4 text-primary">
                Welcome to AMTICS Technical Fest!
            </h1>

            <p class="lead mt-4">
                Get ready to participate in exciting technical events,
                competitions, quizzes, hackathons and more.
            </p>

            <p>
                Showcase your technical skills, creativity and innovation.
            </p>

            <div class="mt-4">

                <a asp-action="Index" asp-controller="Fest" class="btn btn-primary me-2">
                    View Participants
                </a>

                <a asp-action="Register" asp-controller="Fest" class="btn btn-success">
                    Register Now
                </a>

            </div>

        </div>

    </div>

</div>